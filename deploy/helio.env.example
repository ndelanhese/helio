# Copy to helio.env for local, non-secret runtime overrides.
# Keep logger addresses, serial numbers, locations, and credentials out of Git.
#
# Compose publishes to 127.0.0.1:8080 by default. HELIO_BIND_IP and
# HELIO_HOST_PORT are Compose interpolation values and are not read from this
# service env file. For phone access, set them in the shell or a project-level
# .env. Use this host's RFC1918 LAN interface address only. Never use 0.0.0.0
# or a public interface address unless a trusted platform proxy owns exposure.
# HELIO_BIND_IP=<RFC1918-LAN-interface-IP>
# HELIO_HOST_PORT=8080
HELIO_HTTP_ADDR=:8080
HELIO_DATABASE_PATH=/data/helio.db
HELIO_SECURE_COOKIES=0
HELIO_ALLOW_NON_PRIVATE_LOGGER=0
# Required only for encrypted optional cloud integrations. Generate once with:
# openssl rand -base64 32
# Keep this value outside Git and backups. Losing it means re-entering cloud credentials.
# HELIO_SECRETS_KEY=<base64-32-byte-key>

# Optional Echo Show widget relay. Helio sends only current power, today's
# energy, state, freshness, and observation time. See integrations/alexa-relay.
# HELIO_ALEXA_RELAY_URL=https://helio-alexa.ndelanhese.online/ingest
# Generate with: openssl rand -base64 32
# Use the same value as HELIO_SHARED_SECRET in the relay.
# HELIO_ALEXA_SHARED_SECRET=<base64-32-byte-key>
